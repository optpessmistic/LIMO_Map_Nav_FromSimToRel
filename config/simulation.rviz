Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 110; 110; 110
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Value: true
      Alpha: 0.85
      Color Scheme: map
      Draw Behind: true
      Use Timestamp: false
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Update Topic:
        Value: /map_updates
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/RobotModel
      Name: LIMO
      Enabled: true
      Value: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Links:
        All Links Enabled: true
      TF Prefix: ""
      Update Interval: 0
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Value: true
      Alpha: 1
      Color: 30; 220; 255
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Size (m): 0.02
      Decay Time: 0
      Use Fixed Frame: true
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Filter size: 10
    - Class: rviz_default_plugins/Path
      Name: Navigation plan
      Enabled: true
      Value: true
      Alpha: 1
      Color: 30; 220; 80
      Line Style: Billboards
      Line Width: 0.035
      Buffer Length: 1
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Topic:
        Value: /plan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Filter size: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: Confirmed targets
      Enabled: true
      Value: true
      Topic:
        Value: /mission/targets
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Filter size: 10
      Namespaces: {}
    - Class: rviz_default_plugins/Image
      Name: RGB camera
      Enabled: true
      Value: true
      Normalize Range: true
      Topic:
        Value: /camera/color/image_raw
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Transport Hint: raw
    - Class: rviz_default_plugins/TF
      Name: TF (optional)
      Enabled: false
      Value: false
      Show Names: false
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.25
      Frames:
        All Enabled: true
  Enabled: true
  Global Options:
    Background Color: 35; 38; 43
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Angle: 0
      Scale: 90
      X: 1
      Y: 0
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Width: 1280
  Height: 850
